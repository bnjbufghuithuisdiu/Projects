Graphics driver currently in use: null""")
template1 = GetTemplate(TemplateName="CFX")
system2 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system1)
setupComponent2 = system2.GetComponent(Name="Setup")
meshComponent1.TransferData(TargetComponent=setupComponent2)
meshComponent1.Update(AllDependencies=True)
setup2 = system2.GetContainer(ComponentName="Setup")
setup2.Edit()
setup2.Exit()
system2.Delete()
Save(Overwrite=True)
